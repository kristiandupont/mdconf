{
  "name": "@kristiandupont/mdconf",
  "version": "1.1.3",
  "description": "Markdown configuration",
  "keywords": [
    "conf",
    "configuration",
    "md",
    "markdown"
  ],
  "contributors": [
    "Kristian Dupont <kristian@kristiandupont.com>"
  ],
  "author": "TJ Holowaychuk <tj@vision-media.ca>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kristiandupont/mdconf"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ]
}
